    TweenService:Create(ToggleMenuBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        BackgroundColor3 = state and Color3.fromRGB(46, 125, 90) or Color3.fromRGB(37, 40, 46)
    }):Play()
end

