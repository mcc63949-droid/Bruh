-- ฟังก์ชันหา Parent ของ UI ที่รองรับ Executor บน PC ทุกชนิด
local function GetSafeGuiParent()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then
            return hui
        end
    end
    local okCore, _ = pcall(function()
        return CoreGui:GetChildren()
    end)
    if okCore then
        return CoreGui
    end
    return PlayerGui
end

